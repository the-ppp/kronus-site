{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/((?!\\.well-known/|auth/).*)",
      "has": [
        {
          "type": "host",
          "value": "www.kronustime.com"
        }
      ],
      "destination": "https://www.kronusdiscipline.com/$1",
      "permanent": true
    }
  ]
}
